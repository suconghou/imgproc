# 演示页需要跨源隔离 —— libvips 的 pthread 构建没有这个就跑不起来。
# 只给页面加，避免给工具包的资源响应带上无关的头。
/
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/index.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/*
  X-Content-Type-Options: nosniff

# 工具包本体：允许别的站点跨源 <script src> / import / fetch
#   - Access-Control-Allow-Origin  → 模块 import / fetch 走 CORS 模式
#   - Cross-Origin-Resource-Policy → 消费方页面带 COEP: require-corp 时放行经典 <script src>
/image-engine/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

# wasm 与胶水代码体积大、内容稳定，长缓存
/image-engine/vendor/*
  Cache-Control: public, max-age=31536000, immutable
